# ADR-0013: a page fault the policy does not allow ends in a bug check, in every profile (exit 37).
# An exact fixup is ignored when the interrupted code ran at DEVICE_LEVEL (irql=12): fixups are for
# PASSIVE_LEVEL code only.
exit 37
line ^EXC v=14 err=0x0 .* irql=12 name=PF action=stop$
line ^KAMOS STOP 0x00000002 UNHANDLED_EXCEPTION P1=0xe
forbid action=resume